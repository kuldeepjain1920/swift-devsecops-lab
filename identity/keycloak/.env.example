# .env.example
# Copy to .env in this same folder and fill in real values.
# .env is gitignored (see identity/**/*.env in the root .gitignore) — never commit the real one.

# --- Postgres ---
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Keycloak admin bootstrap account ---
# This is the initial admin login only — create a named personal admin user
# and disable/rotate this one after first login, same principle as not using
# a shared root account long-term.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Hostname ---
# Use swift-idp-01's internal IP (confirmed via `terraform output idp_vm_internal_ip`).
##KC_HOSTNAME=10.20.0.2
